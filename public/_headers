# Cloudflare Pages / Netlify response headers.

# Built JS/CSS have content hashes in their names: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell must always be fresh so new deploys show up immediately.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self "https://api.razorpay.com" "https://checkout.razorpay.com")
